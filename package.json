{
  "name": "ultraterm-plan",
  "version": "0.1.2",
  "description": "Phased todo tracking for coding agents: one active task, recorded starts and finishes, blocked items with reasons. Local files, no network. Works with Claude Code, Codex, Pi and any agent with a shell.",
  "license": "MIT",
  "author": "Michael Berardi (https://github.com/michael-berardi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-berardi/ultraterm-plan.git"
  },
  "type": "module",
  "bin": {
    "ut-todo": "bin/ut-todo"
  },
  "exports": {
    ".": "./src/core.ts",
    "./core": "./src/core.ts",
    "./render": "./src/render.ts",
    "./pi-extension": "./pi/extension.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "integrations",
    "pi",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ai-agents",
    "coding-agent",
    "agentic-workflow",
    "planning",
    "todo",
    "task-list",
    "claude-code",
    "codex",
    "pi-coding-agent",
    "gemini-cli",
    "opencode",
    "llm",
    "cli",
    "terminal",
    "developer-tools",
    "ultraterm"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": ">=1.3.25 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "homepage": "https://github.com/michael-berardi/ultraterm-plan#readme",
  "bugs": {
    "url": "https://github.com/michael-berardi/ultraterm-plan/issues"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
